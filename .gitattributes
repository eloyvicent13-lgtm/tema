# Forzar LF en todos los archivos de texto para que el servidor Linux
# nunca reciba CRLF, independientemente del editor/OS del desarrollador.
* text=auto eol=lf

# Binarios: sin conversion
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.otf binary